<odoo> 
    <!-- Regla de acceso a las tareas propias -->
    <!-- Solo permite ver las tareas asignadas al usuario actual -->    
    <!--se agrego el comando data noupdate = 1 -->
    <data noupdate="1">
      <record id="user_task_own_rule" model="ir.rule">
        <field name="name">Acceso a mis tareas </field>
        <field name="model_id" ref="model_user_task"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('base.group_user'))]"/> 
        <!-- solo par ver las propias tareas -->
      </record>
</data>
</odoo>

   